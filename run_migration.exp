#!/usr/bin/expect -f
set timeout -1
set password "wvpi2!ZnTcV];ncy"

spawn ssh graceandforce@65.20.85.75
expect "password:"
send "$password\r"
expect "$ "

send "cat << 'INNER_EOF' > /home/graceandforce/debate-engine/backend/migrate_indus.js\r"
send "require('dotenv').config();\r"
send "const { Pool } = require('pg');\r"
send "const dbUrl = process.env.DATABASE_URL || 'postgresql://graceandforce_user:Pck/aawJlsLFZxWu3CG7aw==@localhost:5432/graceandforce_db';\r"
send "const pool = new Pool({ connectionString: dbUrl, ssl: dbUrl.includes('localhost') ? false : { rejectUnauthorized: false } });\r"
send "\r"
send "async function migrate() {\r"
send "  try {\r"
send "    const res = await pool.query('SELECT * FROM indus_mun_registrations');\r"
send "    console.log('Found ' + res.rows.length + ' registrations to migrate.');\r"
send "    \r"
send "    await pool.query(\`CREATE TABLE IF NOT EXISTS indusmun_individuals (\r"
send "      id SERIAL PRIMARY KEY, name VARCHAR(255), email VARCHAR(255),\r"
send "      mobile VARCHAR(50), grade VARCHAR(100), city VARCHAR(255), state VARCHAR(255),\r"
send "      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\r"
send "    )\`);\r"
send "\r"
send "    for (const r of res.rows) {\r"
send "      if (r.email) {\r"
send "        await pool.query('UPDATE users SET indusmun_registered = true WHERE email = \$1', [r.email]);\r"
send "      } else if (r.mobile) {\r"
send "        await pool.query('UPDATE users SET indusmun_registered = true WHERE mobile = \$1', [r.mobile]);\r"
send "      }\r"
send "      \r"
send "      const exists = await pool.query('SELECT id FROM indusmun_individuals WHERE email = \$1 OR mobile = \$2', [r.email || 'N/A', r.mobile || 'N/A']);\r"
send "      if (exists.rows.length === 0) {\r"
send "        await pool.query(\r"
send "          \`INSERT INTO indusmun_individuals (name, email, mobile, grade, city, state, created_at) \r"
send "           VALUES (\$1, \$2, \$3, \$4, \$5, \$6, \$7)\`,\r"
send "          [r.student_name || '', r.email || '', r.mobile || '', r.grade || '', '', '', r.created_at]\r"
send "        );\r"
send "      }\r"
send "    }\r"
send "    console.log('Migration complete.');\r"
send "  } catch (err) {\r"
send "    console.error(err);\r"
send "  } finally {\r"
send "    pool.end();\r"
send "  }\r"
send "}\r"
send "migrate();\r"
send "INNER_EOF\r"

expect "$ "
send "cd /home/graceandforce/debate-engine/backend && node migrate_indus.js\r"
expect "$ "
send "rm migrate_indus.js\r"
expect "$ "
send "exit\r"
expect eof
